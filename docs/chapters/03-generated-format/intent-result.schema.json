{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "type" : "object",
  "properties" : {
    "confidence" : {
      "type" : "number"
    },
    "intent" : {
      "type" : "string",
      "enum" : [ "PRODUCT_CONSULTATION", "ORDER_QUERY", "LOGISTICS_QUERY", "REFUND_REQUEST", "HUMAN_SERVICE", "OTHER", "UNKNOWN" ]
    },
    "missingFields" : {
      "type" : "array",
      "items" : {
        "type" : "string"
      }
    },
    "orderNo" : {
      "type" : "string"
    }
  },
  "required" : [ "confidence", "intent", "missingFields", "orderNo" ],
  "additionalProperties" : false
}
